# Phase 10 (D22): Spring Boot as a non-root service, bound to loopback behind Nginx.
# Installed as /etc/systemd/system/media-pipeline.service by scripts/deploy-demo.sh.
# Secrets live only in /etc/media-pipeline.env (root:root 0600), written over SSH.
[Unit]
Description=Media Pipeline backend
After=network-online.target
Wants=network-online.target

[Service]
User=mp
Group=mp
WorkingDirectory=/opt/media-pipeline
EnvironmentFile=/etc/media-pipeline.env
Environment=SERVER_ADDRESS=127.0.0.1
Environment=SERVER_PORT=8080
ExecStart=/usr/bin/java -Xmx512m -jar /opt/media-pipeline/backend.jar
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
