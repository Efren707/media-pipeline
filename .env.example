# Copy to .env (untracked) and fill in your own values.
# Never commit .env. This repo is public.

# Your short name, used in all resource names (lowercase, no spaces)
#   stack:   MediaPipeline-<owner>
#   buckets: mp-<owner>-<purpose>-<accountId>
#   other:   mp-<owner>-<name>
MP_OWNER=yourname

# Email for your SNS test subscription
MP_EMAIL=you@example.com

AWS_REGION=us-east-1

# Comma-separated browser origins allowed to use presigned S3 requests.
# Keep this narrow; never use * for the deployed app.
MP_CORS_ORIGINS=http://localhost:5173

# Phase 7 (login). Generate each with: openssl rand -base64 48 (letters and digits only for the DB)
# Signs login tokens; changing it logs everyone out. 32+ characters.
MP_JWT_SECRET=replace-with-32-plus-random-characters
# RDS master password: 16+ letters and digits. Used by MP_WITH_DB=true scripts/deploy-checkpoint.sh
MP_DB_PASSWORD=replaceWith16PlusLettersAndDigits
# Set after a MP_WITH_DB deploy: jdbc:postgresql://<DbEndpoint>:5432/mediapipeline?sslmode=require
MP_DB_URL=

# The account ID is read from your AWS credentials at deploy time. Don't put it here.
